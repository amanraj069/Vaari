# Copy to frontend/.env.local. The backend must be running (cd backend && npm run dev).
API_URL=http://localhost:4000
AUTH_MODE=demo
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:3000
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
# Only when COGNITO_DOMAIN is a custom domain: the user pool's region, for email sign-in.
COGNITO_REGION=
# The user pool's password policy, exactly as set in Cognito, for the sign-up checklist, e.g.
# min=8,lowercase,uppercase,number,symbol (empty: no checklist; Cognito still enforces its policy).
COGNITO_PASSWORD_POLICY=
# The same value as PROXY_SHARED_SECRET in backend/.env: lets the API rate-limit per farmer, not per Next server.
PROXY_SHARED_SECRET=change-me-local-only-proxy-secret-32chars
# WhatsApp Business number for "See all my fields" (digits with country code, no "+"). Empty: no button.
WHATSAPP_BUSINESS_NUMBER=
# Contact address on /privacy (and its deletion section) and in the footer. Empty: the team's address.
CONTACT_EMAIL=
