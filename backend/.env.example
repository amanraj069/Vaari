# Copy to backend/.env. Defaults work for local development with no AWS account.
PORT=4000
AUTH_MODE=demo
DEMO_MODE=true
DEMO_SESSION_SECRET=change-me-local-only-32-characters-min
ENGINE_MODE=local
ENGINE_TIME_LIMIT_SECONDS=2
STORE_MODE=memory
SEASON_START_DATE=2026-10-01
DEMO_TODAY=2026-10-31
OPTIMUM_LAST_DATE=2026-11-15
# Production / AWS (later)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ENGINE_URL=http://localhost:8000
ENGINE_SHARED_SECRET=change-me-local-only
