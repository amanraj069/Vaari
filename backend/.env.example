# Copy to backend/.env. Defaults work for local development with no AWS account (REPO=memory).
# In production (NODE_ENV=production) the API refuses to start unless SLOT_TOKEN_SECRET,
# DEMO_SESSION_SECRET, ENGINE_SHARED_SECRET and PROXY_SHARED_SECRET are each set, at least 32
# characters, and not one of the placeholders below. Generate one with: openssl rand -base64 48
PORT=4000
# info: every change, webhook, refusal (4xx, with its reason) and failure (5xx, with its stack).
# debug: also each successful GET (the web app polls every few seconds).
LOG_LEVEL=info
AUTH_MODE=demo
DEMO_SESSION_SECRET=change-me-local-only-32-characters-min
SLOT_TOKEN_SECRET=change-me-local-only-32-characters-min
ENGINE_MODE=local
ENGINE_TIME_LIMIT_SECONDS=2
# Planner: cpsat (reference, default; falls back to search when it finds no plan in time) or search
ENGINE_METHOD=cpsat
ENGINE_SEARCH_SEED=1
SEASON_START_DATE=2026-10-01
# Assumed last day of the sowing season; slot links expire 7 days after it.
SEASON_END_DATE=2026-12-31
# The day the whole site treats as today (simulated; fixed, nothing in the app changes it).
# The demo season's data starts on 1 November.
DATE_TODAY=2026-10-31
OPTIMUM_LAST_DATE=2026-11-15

# Data. REPO=memory needs nothing else. REPO=dynamo uses tables ${TABLE_PREFIX}-* in AWS_REGION;
# credentials come from the AWS default provider chain (aws configure / SSO / EC2 instance role), never this file.
REPO=memory
TABLE_PREFIX=vaari-dev
AWS_REGION=us-east-1
# Only for DynamoDB Local in development:
# DYNAMODB_ENDPOINT=http://localhost:8642

# Behind CloudFront in production: TRUST_PROXY=1. The same PROXY_SHARED_SECRET goes in frontend/.env.
TRUST_PROXY=loopback
PROXY_SHARED_SECRET=change-me-local-only-proxy-secret-32chars
SLOT_RATE_LIMIT_PER_MINUTE=60

# Production / AWS
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ENGINE_URL=http://localhost:8000
ENGINE_SHARED_SECRET=change-me-local-only-engine-secret-32ch

# WhatsApp (Cloud API). Off by default. With WHATSAPP_ENABLED=true in production the API refuses to
# start unless the token, app secret, verify token, phone number id and the three template names are set.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# Utility templates (approved in WhatsApp Manager), each with body parameters {{1}} date and {{2}} sentence.
WHATSAPP_TEMPLATE_NEW_DATE=
WHATSAPP_TEMPLATE_FIRM_DATE=
WHATSAPP_TEMPLATE_DATE_CHANGED=
# The three templates above have a "Visit website" button, URL <web app>/slot/{{1}}: each notice
# carries the field's slot link. false only for templates approved without that button.
WHATSAPP_TEMPLATE_SLOT_BUTTON=true
# Authentication template (copy-code button) for farmer sign-in codes, added in en, pa and hi.
WHATSAPP_TEMPLATE_OTP=
# memory (the API handles messages itself) or sqs (the API enqueues; `npm run worker` handles them).
WHATSAPP_QUEUE=memory
WHATSAPP_SQS_QUEUE_URL=
WHATSAPP_MESSAGES_PER_PHONE_PER_HOUR=30
# The web app's address, for the one-time /farmer links sent on WhatsApp.
WEB_BASE_URL=http://localhost:3000

# How a real farmer's web sign-in code reaches them: whatsapp (WHATSAPP_TEMPLATE_OTP; needs
# WHATSAPP_ENABLED=true) or off. Unset: whatsapp when that is set up, else off. The demo farmers'
# phones always see their code on screen and are never messaged.
FARMER_OTP_DELIVERY=
# More demo farmer phones (E.164, comma-separated) besides the seeded one. Never a real person's number.
DEMO_FARMER_PHONES=

# The agent (Strands on Bedrock). Off: farmers get the menu and buttons, no model.
AGENT_ENABLED=false
# Nova 2 Lite: from ap-south-1 only the global cross-region profile is available.
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_REGION=ap-south-1
AGENT_TIMEOUT_SECONDS=20

# Docker (backend/docker-compose.yml; see backend/deploy/README.md). This same file is the
# containers' environment: every line above reaches the api and the worker. Inside containers
# Compose sets ENGINE_MODE=http, ENGINE_URL=http://engine:8000, DATA_DIR=/app/data and listens on
# 4000; PORT here is the host port (keep CloudFront's origin port). NODE_ENV defaults to
# production in Docker: set NODE_ENV=development to run the placeholder secrets above in containers.
# A value containing $ must be single-quoted. Optional switches Compose reads from this file:
# COMPOSE_PROFILES=worker      also run the WhatsApp worker (WHATSAPP_QUEUE=sqs; deploy.sh turns it on by itself)
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudwatch.yml   container logs to CloudWatch (/vaari/backend)
