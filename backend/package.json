{
  "name": "vaari-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vaari backend: Express API (TypeScript) plus the Python scheduling engine in ./engine.",
  "scripts": {
    "predev": "node scripts/ensure-engine.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup src/server.ts src/worker.ts src/check-config.ts --format esm --target node22 --out-dir dist --clean",
    "prestart": "node scripts/ensure-engine.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "worker:dev": "tsx --env-file-if-exists=.env src/worker.ts",
    "test": "npm run test:engine && npm run test:api",
    "test:api": "vitest run",
    "test:engine": "cd engine && uv run pytest -q",
    "preplan": "node scripts/ensure-engine.mjs",
    "plan": "cd engine && uv run --quiet python -m vaari_engine plan",
    "simulate": "cd engine && uv run --quiet python -m vaari_engine simulate",
    "simulate:check": "node scripts/simulate-check.mjs",
    "typecheck": "tsc --noEmit",
    "engine:setup": "cd engine && uv sync",
    "contract:sync": "node scripts/sync-contract.mjs",
    "db:create": "tsx --env-file-if-exists=.env scripts/db.ts create",
    "db:status": "tsx --env-file-if-exists=.env scripts/db.ts status",
    "test:dynamo": "REPO=dynamo TABLE_PREFIX=vaari-test vitest run",
    "data:villages": "tsx scripts/data/villages.ts",
    "data:boundaries": "tsx scripts/data/boundaries.ts",
    "data:prepare": "tsx scripts/data/prepare.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1139.0",
    "@aws-sdk/client-polly": "3.1139.0",
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/client-sqs": "3.1139.0",
    "@aws-sdk/client-transcribe": "3.1139.0",
    "@aws-sdk/lib-dynamodb": "3.1139.0",
    "@cedar-policy/cedar-wasm": "4.13.0",
    "@strands-agents/sdk": "1.20.0",
    "aws-jwt-verify": "5.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
