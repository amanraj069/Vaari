{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ContainerLogsToCloudWatch",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/vaari/backend*"
    }
  ]
}
